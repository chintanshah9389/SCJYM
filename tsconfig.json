{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "build",
    ".next",
    ".expo"
  ]
}
