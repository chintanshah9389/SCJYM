# ─── Backend API Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# On Render, set these directly as Environment Variables (no file needed).

# ── MongoDB ───────────────────────────────────────────────────────────────────
# LOCAL:
MONGODB_URI=mongodb://localhost:27017/scjygm

# PRODUCTION (Atlas):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.uq5gk2l.mongodb.net/scjygm?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ── Super Admin (seed account) ────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@scjygm.com
SUPER_ADMIN_PASSWORD=REPLACE_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_FULL_NAME=Super Admin

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_CLOUDINARY_API_SECRET

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@scjygm.local

# ── FCM ───────────────────────────────────────────────────────────────────────
FCM_SERVER_KEY=REPLACE_FCM_SERVER_KEY

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
API_BASE_URL=http://localhost:8000/api/v1
