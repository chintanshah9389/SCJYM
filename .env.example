# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scjygm

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ── Super-Admin seed ──────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=SuperSecureP@ssw0rd!
SUPER_ADMIN_FULL_NAME=Super Admin

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
FCM_SERVER_KEY=AAAA_your_fcm_server_key_here

# ── Cloudinary (image/video storage) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── App URLs ──────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000/api/v1
ADMIN_BASE_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=scjygm

# ── Email (dev stub – set SMTP vars for real sending) ────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@scjygm.local

# ── Next.js (admin) ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
