# ─── Admin App Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored by Next.js automatically.

# ── API ───────────────────────────────────────────────────────────────────────
# PRODUCTION:
API_BASE_URL=https://scjym-api.onrender.com/api/v1

# LOCAL dev (uncomment when needed):
# API_BASE_URL=http://localhost:8000/api/v1

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_NEXTAUTH_SECRET

# ── Firebase Web (Admin) ─────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=REPLACE_FIREBASE_MEASUREMENT_ID

# PRODUCTION NextAuth (uncomment for Vercel):
# NEXTAUTH_URL=https://your-admin-app.vercel.app
