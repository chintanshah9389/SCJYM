# ─── Mobile App Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# All EXPO_PUBLIC_ vars are bundled into the app at build time.

# ── API ───────────────────────────────────────────────────────────────────────
# LOCAL dev:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PRODUCTION (uncomment and comment out LOCAL line above):
# EXPO_PUBLIC_API_BASE_URL=https://scjym-api.onrender.com/api/v1

# ── Cloudinary (public values only) ──────────────────────────────────────────
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_CLOUDINARY_CLOUD_NAME
EXPO_PUBLIC_CLOUDINARY_API_KEY=REPLACE_CLOUDINARY_API_KEY

# ── FCM / Firebase ────────────────────────────────────────────────────────────
EXPO_PUBLIC_FCM_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
